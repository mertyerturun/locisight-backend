# Flask session signing key — use a long random string in production
SECRET_KEY=change-me

# Groq API key (https://console.groq.com/keys). Leave empty to run in demo mode.
GROQ_API_KEY=

# Secret token required to read leads (GET /api/leads). If empty, that endpoint is disabled.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
